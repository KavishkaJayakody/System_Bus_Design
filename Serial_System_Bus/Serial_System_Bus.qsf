set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 24.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "00:30:45  SEPTEMBER 08, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name NOMINAL_CORE_SUPPLY_VOLTAGE 1.2V
set_global_assignment -name EDA_SIMULATION_TOOL "QuestaSim (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan

# ==========================================================================
# Project settings added for the 2-master / 3-slave shared bus design.
# Device EP4CE115F29C7 (Cyclone IV E) = Terasic DE2-115.
# ==========================================================================

set_global_assignment -name TOP_LEVEL_ENTITY top_debug

# rtl/ is on the search path so `include "bus_defs.vh" resolves.
set_global_assignment -name SEARCH_PATH rtl

# --- RTL ------------------------------------------------------------------
set_global_assignment -name VERILOG_INCLUDE_FILE rtl/bus_defs.vh
set_global_assignment -name VERILOG_FILE rtl/shift_ser.v
set_global_assignment -name VERILOG_FILE rtl/shift_deser.v
set_global_assignment -name VERILOG_FILE rtl/addr_decoder.v
set_global_assignment -name VERILOG_FILE rtl/arbiter.v
set_global_assignment -name VERILOG_FILE rtl/bus_mux.v
set_global_assignment -name VERILOG_FILE rtl/slave.v
set_global_assignment -name VERILOG_FILE rtl/default_slave.v
set_global_assignment -name VERILOG_FILE rtl/master.v
set_global_assignment -name VERILOG_FILE rtl/uart_tx.v
set_global_assignment -name VERILOG_FILE rtl/uart_rx.v
set_global_assignment -name VERILOG_FILE rtl/bus_bridge.v
set_global_assignment -name VERILOG_FILE rtl/system_bus.v
set_global_assignment -name VERILOG_FILE rtl/bus_top.v
set_global_assignment -name VERILOG_FILE rtl/bus_issp_driver.v
set_global_assignment -name VERILOG_FILE rtl/top_debug.v

# --- Testbenches (simulation only, never compiled into the fitter) --------
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_shift_ser.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_shift_deser.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_addr_decoder.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_arbiter.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_bus_mux.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_slave.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_default_slave.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_master.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_system_bus.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_integration.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_bus_issp_driver.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/altsource_probe_stub.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_uart_remote.v -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb/tb_top_debug.v -section_id eda_simulation

# --- Timing ---------------------------------------------------------------
set_global_assignment -name SDC_FILE Serial_System_Bus.sdc

# --- Board-wide I/O -------------------------------------------------------
# The DE2-115 banks default to 2.5 V in Quartus; the board is 3.3 V LVTTL.
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"
# The DE2-115 hangs SDRAM, SRAM, flash, ethernet, audio, VGA and the HSMC
# connector off pins this design does not use.  The Quartus default of
# "as output driving ground" would drive into all of them.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

# --- Pin locations --------------------------------------------------------
# CLOCK_50
set_location_assignment PIN_Y2 -to CLOCK_50

# KEY[0] -> rst_n
set_location_assignment PIN_M23 -to rst_n

# Board-to-board link, per the interface spec agreed with the other team.
# 8N1 at 115200 baud, crossed over, plus a COMMON GROUND.
#
# The spec quotes PIN_D3 / PIN_C3, but those are the OTHER board's pins -
# it says "MY rm_tx PIN_D3" and leaves "your rm_rx" to us.  Neither exists
# on the EP4CE115F29C7 anyway (the fitter rejects D3 outright).  These are
# the DE2-115's GPIO header JP5, the same pair System_Bus_Final used for its
# board-to-board link.  Only the baud rate and frame format have to match
# between boards; the pins do not.
set_location_assignment PIN_AC15 -to rm_tx
set_location_assignment PIN_AB22 -to rm_rx

# LEDR
set_location_assignment PIN_G19 -to led[0]
set_location_assignment PIN_F19 -to led[1]
set_location_assignment PIN_E19 -to led[2]
set_location_assignment PIN_F21 -to led[3]
set_location_assignment PIN_F18 -to led[4]
set_location_assignment PIN_E18 -to led[5]
set_location_assignment PIN_J19 -to led[6]
set_location_assignment PIN_H19 -to led[7]

# --- I/O standard on every used pin --------------------------------------

set_global_assignment -name NUM_PARALLEL_PROCESSORS 4

set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
