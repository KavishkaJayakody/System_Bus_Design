set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY top_debug
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_CREATION_TIME_DATE "14:37:57  SEPTEMBER 01, 2026"
set_global_assignment -name LAST_QUARTUS_VERSION "24.1std.0 Lite Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
set_global_assignment -name EDA_SIMULATION_TOOL "Questa Altera FPGA (Verilog)"
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_timing
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_symbol
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_signal_integrity
set_global_assignment -name EDA_GENERATE_FUNCTIONAL_NETLIST OFF -section_id eda_board_design_boundary_scan
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_address_decoder
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_address_decoder -section_id tb_address_decoder
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_arbiter_2m_split
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_arbiter_2m_split -section_id tb_arbiter_2m_split
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_slave_fast_ram
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_slave_fast_ram -section_id tb_slave_fast_ram
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_slave_0_split_4k
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_slave_0_split_4k -section_id tb_slave_0_split_4k
set_global_assignment -name EDA_TEST_BENCH_FILE tb_address_decoder.v -section_id tb_address_decoder
set_global_assignment -name EDA_TEST_BENCH_FILE tb_arbiter_2m_split.v -section_id tb_arbiter_2m_split
set_global_assignment -name EDA_DESIGN_INSTANCE_NAME NA -section_id tb_top_bus_system
set_global_assignment -name EDA_TEST_BENCH_MODULE_NAME tb_top_bus_system -section_id tb_top_bus_system
set_global_assignment -name EDA_TEST_BENCH_FILE tb_top_bus_system.v -section_id tb_top_bus_system
# ---------------------------------------------------------------------------
# DE2-115 (Terasic) pin assignments  --  EP4CE115F29C7
# Board user I/O runs at 3.3 V; Quartus otherwise defaults these to 2.5 V.
# ---------------------------------------------------------------------------
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"

# Unused pins must NOT drive. The DE2-115 wires SDRAM, SRAM, flash, ethernet,
# audio and the HSMC connector to pins this design does not use; Quartus'
# default of "as output driving ground" would fight those devices.
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"

# CLOCK_50 -- onboard 50 MHz oscillator
set_location_assignment PIN_Y2 -to clk

# KEY[0] -- push button, active low with pull-up, matches active-low rst_n
set_location_assignment PIN_M23 -to rst_n

# LEDR[7:0] -- red LEDs, active high, shows Master 0 read data
set_location_assignment PIN_G19 -to led[0]
set_location_assignment PIN_F19 -to led[1]
set_location_assignment PIN_E19 -to led[2]
set_location_assignment PIN_F21 -to led[3]
set_location_assignment PIN_F18 -to led[4]
set_location_assignment PIN_E18 -to led[5]
set_location_assignment PIN_J19 -to led[6]
set_location_assignment PIN_H19 -to led[7]

# UART link to the other board -- GPIO header JP5, GPIO[0] and GPIO[1]
set_location_assignment PIN_AB22 -to ext_rx_serial
set_location_assignment PIN_AC15 -to ext_tx_serial
set_global_assignment -name TCL_SCRIPT_FILE issp_bus_test.tcl
set_global_assignment -name VERILOG_FILE tb_address_decoder.v
set_global_assignment -name VERILOG_FILE tb_arbiter_2m_split.v
set_global_assignment -name VERILOG_FILE tb_master_node.v
set_global_assignment -name VERILOG_FILE tb_slave_0_split_4k.v
set_global_assignment -name VERILOG_FILE tb_top_bus_system.v
set_global_assignment -name VERILOG_FILE tb_uart_remote.v
set_global_assignment -name VERILOG_FILE address_decoder.v
set_global_assignment -name VERILOG_FILE arbiter_2m_split.v
set_global_assignment -name VERILOG_FILE master_node.v
set_global_assignment -name VERILOG_FILE master_node_uart.v
set_global_assignment -name VERILOG_FILE slave_0_split_4k.v
set_global_assignment -name VERILOG_FILE slave_fast_ram.v
set_global_assignment -name VERILOG_FILE top_bus_system.v
set_global_assignment -name VERILOG_FILE uart_tx.v
set_global_assignment -name VERILOG_FILE uart_rx.v
set_global_assignment -name VERILOG_FILE bus_interconnect.v
set_global_assignment -name VERILOG_FILE bus_issp_driver.v
set_global_assignment -name VERILOG_FILE top_debug.v
set_global_assignment -name VERILOG_FILE tb_slave_fast_ram.v
set_global_assignment -name SOURCE_FILE Spf1.spf
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_ENABLE_STATUS TEST_BENCH_MODE -section_id eda_simulation
set_global_assignment -name EDA_NATIVELINK_SIMULATION_TEST_BENCH tb_top_bus_system -section_id eda_simulation
set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to rst_n
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[4]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[5]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[6]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led[7]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ext_rx_serial
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to ext_tx_serial
set_global_assignment -name EDA_TEST_BENCH_NAME tb_slave_0_split_4k -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_NAME tb_slave_fast_ram -section_id eda_simulation
set_global_assignment -name EDA_TEST_BENCH_FILE tb_slave_0_split_4k.v -section_id tb_slave_0_split_4k
set_global_assignment -name EDA_TEST_BENCH_FILE tb_slave_fast_ram.v -section_id tb_slave_fast_ram
set_global_assignment -name EDA_TEST_BENCH_NAME tb_top_bus_system -section_id eda_simulation
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top