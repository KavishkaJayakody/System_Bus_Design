# ============================================================
# Quartus generated files
# ============================================================

**/db/
**/incremental_db/
**/output_files/

# Quartus reports and generated output
**/*.rpt
**/*.summary
**/*.done

# Quartus workspace / temporary files
**/*.qws
**/*.qdf
**/*.qws.bak


# ============================================================
# Quartus temporary / backup files
# ============================================================

**/*.bak
**/*.bak*
**/*.tmp
**/*.log


# ============================================================
# Questa / ModelSim generated files
# ============================================================

# Compiled simulation libraries
**/simulation/**/rtl_work/
**/simulation/**/work/
**/simulation/**/library/

# Questa / ModelSim waveform and transcript files
**/*.wlf
**/msim_transcript

# Questa compiled database files
**/*.qdb
**/*.qtl

# Quartus-generated gate-level netlists for Questa.  These are build output -
# the .vo alone is ~1 MB and is rewritten on every compile.
**/simulation/questa/*.vo
**/simulation/questa/*.xrf
**/simulation/questa/*.do
**/simulation/questa/modelsim.ini

# Additional generated Questa/ModelSim files
**/*.sft
**/*.svo


# ============================================================
# Operating system files
# ============================================================

.DS_Store
Thumbs.db


# ============================================================
# IDE / editor files
# ============================================================

.vscode/
.idea/